{"openapi":"3.0.3","info":{"title":"SKAN SDKLess API - Custon Decode State","version":"1.0.0"},"servers":[{"url":"https://skadsdkless.appsflyer.com/v2.0/","description":"SKAN v4.0"}],"paths":{"/custom-decode-state":{"get":{"tags":["SKAdSDKLess API"],"summary":"Custom Decode State","description":"Marketers using decode mode in Conversion Studio can now leverage AppsFlyer’s Single Source of Truth (SSOT) attribution—without switching to custom encode or SKAN 4 modes \n","operationId":"skan-sdkless-custom-decode-state","parameters":[{"in":"query","name":"uid","required":true,"description":"AppsFlyer ID\n","schema":{"type":"string","maxLength":256}},{"in":"query","name":"app_id","required":true,"description":"Application ID (`idxxxxxxx` format)\n","schema":{"type":"string","pattern":"^id\\\\d{9,}$","example":"id123456789"}},{"in":"header","name":"af_timestamp","required":true,"schema":{"type":"number","format":"int"},"description":"Current time in milliseconds\n"},{"name":"af_sig","in":"header","required":true,"schema":{"type":"string","maxLength":64},"description":"Create an HMAC SHA256 signature by concatenating the values of the timestamp, dev key, app id, and AppsFlyer id: `HmacSHA256(af_timestamp + app_id + uid + dev-key)` \n> Dev Key: is available on the App Settings page in the AppsFlyer dashboard\n","example":"ce2d1e6b4619b9e19bc6be116183b92e43aa01e182b15012a7215bdd879ec327"}],"responses":{"200":{"description":"OK","content":{"text/plain":{"schema":{"type":"string"},"examples":{"Non-organic install":{"value":{"is-non-organic-install":true}},"Organic install":{"value":{"is-non-organic-install":false}}}}}},"404":{"description":"Not Found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"examples":{"Not found":{"value":{"message":"Not found"}}}}}}}}}},"components":{"schemas":{"Error":{"type":"string"}}},"x-readme":{"explorer-enabled":true,"proxy-enabled":true}}