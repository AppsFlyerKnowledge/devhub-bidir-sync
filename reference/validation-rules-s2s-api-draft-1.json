  "paths": {
    "/rules": {
      "post": {
        "tags": [
          "Validation Rules"
        ],
        "summary": "Create rule",
        "description": "Server-to-Server API for managing validation rules: create, list, retrieve, update, and delete.\n\n**Note:** This API is currently a draft and subject to change.\n\nLinks:\n  - [Create rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-create-rule)\n  - [List rules](https://dev.appsflyer.com/hc/reference/new-validation-rules-list-rules)\n  - [Get rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-get-rule)\n  - [Update full rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-update-rule)\n  - [Delete rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-delete-rule)\n  - [Update rule status](https://dev.appsflyer.com/hc/reference/new-validation-rules-update-rule-status)\n",
        "operationId": "new-validation-rules-create-rule",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "A unique key to make the create operation idempotent for at least 24 hours.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rule"
              },
              "examples": {
                "CreateBlockSites": {
                  "summary": "Block installs for specific site IDs and media source",
                  "value": {
                    "name": "Block installs from ms_a on site_a,b",
                    "description": "Quarantines suspicious sites for ms_a",
                    "enable": true,
                    "scope": {
                      "app_ids": [
                        "app_a",
                        "app_b"
                      ],
                      "event": "install"
                    },
                    "action": {
                      "type": "block",
                      "predicates": [
                        {
                          "field": "site_id",
                          "op": "in",
                          "values": [
                            "site_a",
                            "site_b"
                          ]
                        },
                        {
                          "field": "media_source",
                          "op": "in",
                          "values": [
                            "ms_a"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rule created",
            "headers": {
              "Location": {
                "description": "Absolute URL of the created rule resource",
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "example": "/validation-rules/v1.0/rules/2f2a2f7b-...-a1e9"
              },
              "ETag": {
                "description": "Entity tag for the created rule; use with If-Match on updates",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rule"
                },
                "examples": {
                  "CreatedRule": {
                    "value": {
                      "rule_id": "2f2a2f7b-...-a1e9",
                      "version": 1,
                      "name": "Block installs from ms_a on site_a,b",
                      "scope": {
                        "app_ids": [
                          "app_a",
                          "app_b"
                        ],
                        "event": "install"
                      },
                      "action": {
                        "type": "block",
                        "predicates": [
                          {
                            "field": "site_id",
                            "op": "in",
                            "values": [
                              "site_a",
                              "site_b"
                            ]
                          },
                          {
                            "field": "media_source",
                            "op": "in",
                            "values": [
                              "ms_a"
                            ]
                          }
                        ]
                      },
                      "enable": true,
                      "description": "Quarantines suspicious sites for ms_a",
                      "metadata": {
                        "created_at": "2025-09-18T10:22:30Z",
                        "updated_at": "2025-09-18T10:22:30Z",
                        "created_by": "user.email@company.com",
                        "updated_by": "user.email@company.com"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Conflict (e.g., name must be unique, or idempotency conflict)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      },
      "get": {
        "tags": [
          "Validation Rules"
        ],
        "summary": "List rules",
        "description": "Server-to-Server API for managing validation rules: create, list, retrieve, update, and delete.\n\n**Note:** This API is currently a draft and subject to change.\n\nLinks:\n  - [Create rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-create-rule)\n  - [List rules](https://dev.appsflyer.com/hc/reference/new-validation-rules-list-rules)\n  - [Get rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-get-rule)\n  - [Update full rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-update-rule)\n  - [Delete rule](https://dev.appsflyer.com/hc/reference/new-validation-rules-delete-rule)\n  - [Update rule status](https://dev.appsflyer.com/hc/reference/new-validation-rules-update-rule-status)\n",
        "operationId": "new-validation-rules-list-rules",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Max number of items to return (1–1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "description": "Opaque cursor for pagination",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "q",
            "description": "Free-text search over rule name/description",
            "schema": {
              "type": "string"
